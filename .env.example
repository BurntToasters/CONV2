GPG_KEY_ID=
GPG_PASSPHRASE=

# GitHub releases use the GitHub CLI credential store. Run `gh auth login` on
# each release VM; no GitHub token belongs in this file.

AFTER_PACK_LOC=
# Moves cleaned up ./release files to a requested location.

# MacOS Only
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
SSH_USER_PWD=

# ============================================
# Windows Code Signing (Optional)
# ============================================

# Azure Artifact Signing (Public Trust)
# AZURE_CLIENT_SECRET is secret; never commit real credentials.
# Once per Windows release VM (as Administrator), run: npm run setup:win:artifact-signing
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_ARTIFACT_SIGNING_ENDPOINT=
AZURE_ARTIFACT_SIGNING_ACCOUNT=
AZURE_ARTIFACT_SIGNING_PROFILE=
AZURE_ARTIFACT_SIGNING_PUBLISHER=
# Only the exact value 1 permits an unsigned Windows build; missing or 0 enforces signing.
SKIP_WIN_CODESIGN=0
# Optional overrides if Client Tools are installed in a nonstandard location:
# AZURE_ARTIFACT_SIGNING_SIGNTOOL_PATH=
# AZURE_ARTIFACT_SIGNING_DLIB_PATH=

# Legacy local-certificate signing
# Path to your code signing certificate (.pfx file)
# CSC_LINK=

# Password for the certificate
# CSC_KEY_PASSWORD=

# FFmpeg Binary Downloads
# HTTPS base URL containing ffmpeg_{win,macOS,linux}_{x64,arm64}.7z archives.
FFMPEG_DL_SERVER=

# Downloads are verified against resources/ffmpeg/checksums.json before install.
# To move to a NEW FFmpeg version:
#   1. node build-scripts/get-ffmpeg.js --all --allow-unverified
#   2. Independently verify the new binaries against a trusted source.
#   3. npm run ffmpeg:checksums:generate   (sets FFMPEG_ALLOW_CHECKSUM_GENERATION=1 itself)
# Checksum regeneration is intentionally opt-in and never happens during a normal download.
# FFMPEG_ALLOW_CHECKSUM_GENERATION=1
