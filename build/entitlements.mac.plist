<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by V8/Chromium under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Chromium still maps unsigned executable memory; removing this needs a
         signed + notarized launch test before it can be dropped. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- com.apple.security.cs.disable-library-validation is intentionally NOT
         granted: FFmpeg/ffprobe are spawned as separate processes and no
         unsigned third-party libraries are loaded into the app. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
