{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the CONV2 main window",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "allow-get-settings",
    "allow-get-default-settings",
    "allow-save-settings",
    "allow-reset-settings",
    "allow-start-conversion-queue",
    "allow-cancel-conversion",
    "allow-get-queue-snapshot",
    "allow-select-output-directory",
    "allow-select-input-files",
    "allow-get-file-info",
    "allow-get-presets",
    "allow-get-gpu-capabilities",
    "allow-refresh-gpu-capabilities",
    "allow-check-ffmpeg",
    "allow-get-app-platform",
    "allow-get-distribution-channel",
    "allow-get-system-theme",
    "allow-open-external",
    "allow-reveal-path",
    "allow-restart-app",
    "allow-set-conversion-menu-state",
    "allow-log-error",
    "allow-mark-main-window-ready",
    "allow-notify-settings-flushed",
    "allow-check-for-updates",
    "allow-download-update",
    "allow-install-update",
    "allow-cancel-update-download",
    "allow-set-update-channel"
  ]
}
