{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CONV2",
  "version": "2.0.0-beta.1",
  "identifier": "run.rosie.conv2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CONV2",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 12
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; frame-src 'self'; worker-src 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "appimage"
    ],
    "publisher": "BurntToasters",
    "copyright": "Copyright (c) BurntToasters",
    "category": "AudioVideo",
    "shortDescription": "Cross-platform FFmpeg GUI",
    "longDescription": "CONV2 is a fast, friendly graphical front end for FFmpeg with bundled binaries, presets, batch queues, and hardware acceleration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/conv2-ffmpeg",
      "binaries/conv2-ffprobe"
    ],
    "resources": {
      "../resources/ffmpeg/NOTICE.txt": "ffmpeg/NOTICE.txt",
      "../resources/ffmpeg/ffmpeg_license.txt": "ffmpeg/LICENSE.txt",
      "../resources/ffmpeg/SOURCE_OFFER.txt": "ffmpeg/SOURCE_OFFER.txt",
      "../resources/ffmpeg/checksums.json": "ffmpeg/checksums.json"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "15.0",
      "dmg": {
        "appPosition": {
          "x": 130,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 220
        }
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BurntToasters/CONV2/releases/latest/download/latest-{{target}}-{{arch}}.json",
        "https://github.com/BurntToasters/CONV2/releases/latest/download/latest-{{target}}.json"
      ],
      "pubkey": "REPLACE_WITH_CONV2_MINISIGN_PUBKEY",
      "requireSignedVersion": true
    }
  }
}
